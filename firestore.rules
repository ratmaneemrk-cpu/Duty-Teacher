rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // ครูเข้าใช้งานด้วยการพิมพ์ชื่อ (Firebase Anonymous Auth) ไม่ต้องใช้รหัสผ่าน
    function isNameLogin() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    // รหัสผ่านผู้ดูแลระบบคือ id ของเอกสารใน adminSecrets (ไม่มีใครอ่านได้ก่อนเป็นผู้ดูแล)
    // แต่ละรหัสผูกกับชื่อผู้ใช้งาน (ฟิลด์ username) ใช้กับชื่อผู้ใช้งานอื่นไม่ได้
    function adminSecret(code) {
      return /databases/$(database)/documents/adminSecrets/$(code);
    }
    function hasAdminCode() {
      return request.resource.data.adminCode is string
        && request.resource.data.adminCode.size() > 0
        && exists(adminSecret(request.resource.data.adminCode))
        && get(adminSecret(request.resource.data.adminCode)).data.username == request.resource.data.username;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }
    function isStaff() {
      return signedIn() && myRole() in ['teacher', 'admin'];
    }
    function reportDoc(id) {
      return get(/databases/$(database)/documents/reports/$(id)).data;
    }

    // ผู้ใช้: เข้าด้วยชื่อได้สถานะ teacher ทันที, เข้าด้วย Google ได้ pending ให้ผู้ดูแลกำหนดบทบาท
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && (request.resource.data.role == 'pending'
            || (isNameLogin() && request.resource.data.role == 'teacher')
            || (isNameLogin() && request.resource.data.role == 'admin' && hasAdminCode()));
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // รายงานเวร: ครูเห็น/แก้ได้เฉพาะของตนเองที่ยังไม่ถูกรับทราบ ผู้ดูแลเห็นทั้งหมด
    match /reports/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.uid == request.auth.uid);
      allow create: if isStaff()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && !request.resource.data.keys().hasAny(['adminComment', 'acknowledgedBy', 'acknowledgedAt']);
      allow update: if isAdmin()
        || (isStaff()
            && resource.data.uid == request.auth.uid
            && resource.data.status == 'submitted'
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['uid', 'status', 'adminComment', 'acknowledgedBy', 'acknowledgedAt']));
      allow delete: if isAdmin()
        || (isStaff() && resource.data.uid == request.auth.uid && resource.data.status == 'submitted');

      match /photos/{photoId} {
        allow read: if isAdmin() || (isStaff() && reportDoc(id).uid == request.auth.uid);
        allow write: if isAdmin()
          || (isStaff() && reportDoc(id).uid == request.auth.uid && reportDoc(id).status == 'submitted');
      }
    }

    // บุคลากร: ทุกคนดูได้ (ใช้หาชื่อจากชื่อผู้ใช้งานตอนเข้าระบบ) แก้ไขได้เฉพาะผู้ดูแลระบบ
    match /personnel/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.username is string
        && request.resource.data.username.matches('[a-z0-9_.-]{1,20}')
        && request.resource.data.dutyDay is int
        && request.resource.data.dutyDay >= 0
        && request.resource.data.dutyDay <= 5
        && request.resource.data.head is bool;
      allow delete: if isAdmin();
    }

    // รหัสผ่านผู้ดูแลระบบ: ผู้ดูแลเปลี่ยนได้ (ตั้งครั้งแรกใน Firebase Console)
    match /adminSecrets/{code} {
      allow read, write: if isAdmin();
    }

    // ตารางเวร: ทุกคนในระบบดูได้ ผู้ดูแลจัดการ
    match /schedules/{date} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
  }
}
