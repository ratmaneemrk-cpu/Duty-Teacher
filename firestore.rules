rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // ครูเข้าใช้งานด้วยการพิมพ์ชื่อ (Firebase Anonymous Auth) ไม่ต้องใช้รหัสผ่าน
    function isNameLogin() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    // รหัสผ่าน: เอกสาร passwords/{ชื่อผู้ใช้งาน}__{รหัสผ่าน} (อ่านได้เฉพาะผู้ดูแล)
    // ตอนเข้าระบบ ผู้ใช้ส่ง loginCode มากับโปรไฟล์ ต้องมีเอกสารรหัสผ่านนี้ของชื่อผู้ใช้งานนี้
    function loginSecret() {
      return /databases/$(database)/documents/passwords/$(request.resource.data.username + '__' + request.resource.data.loginCode);
    }
    function hasLoginCode() {
      return request.resource.data.username is string
        && request.resource.data.loginCode is string
        && request.resource.data.loginCode.size() > 0
        && exists(loginSecret())
        && get(loginSecret()).data.username == request.resource.data.username;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }
    function isStaff() {
      return signedIn() && myRole() in ['teacher', 'admin'];
    }
    function reportDoc(id) {
      return get(/databases/$(database)/documents/reports/$(id)).data;
    }

    // ผู้ใช้: เข้าด้วยชื่อได้สถานะ teacher ทันที, เข้าด้วย Google ได้ pending ให้ผู้ดูแลกำหนดบทบาท
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && isNameLogin()
        && hasLoginCode()
        && (request.resource.data.role == 'teacher'
            || (request.resource.data.role == 'admin' && get(loginSecret()).data.admin == true));
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // รายงานเวร: ครูเห็น/แก้ได้เฉพาะของตนเองที่ยังไม่ถูกรับทราบ ผู้ดูแลเห็นทั้งหมด
    // รูปภาพต่อรายงานไม่เกิน 2 รูป (MAX_PHOTOS ใน src/constants.js)
    function photoLimitOk() {
      return !('photoCount' in request.resource.data) || request.resource.data.photoCount <= 2;
    }

    match /reports/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.uid == request.auth.uid);
      allow create: if isStaff()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && photoLimitOk()
        && !request.resource.data.keys().hasAny(['adminComment', 'acknowledgedBy', 'acknowledgedAt']);
      allow update: if isAdmin()
        || (isStaff()
            && resource.data.uid == request.auth.uid
            && resource.data.status == 'submitted'
            && photoLimitOk()
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['uid', 'status', 'adminComment', 'acknowledgedBy', 'acknowledgedAt']));
      allow delete: if isAdmin()
        || (isStaff() && resource.data.uid == request.auth.uid && resource.data.status == 'submitted');

      match /photos/{photoId} {
        allow read: if isAdmin() || (isStaff() && reportDoc(id).uid == request.auth.uid);
        allow write: if isAdmin()
          || (isStaff() && reportDoc(id).uid == request.auth.uid && reportDoc(id).status == 'submitted');
      }
    }

    // บุคลากร: ทุกคนดูได้ (ใช้หาชื่อจากชื่อผู้ใช้งานตอนเข้าระบบ) แก้ไขได้เฉพาะผู้ดูแลระบบ
    match /personnel/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.username is string
        && request.resource.data.username.matches('[a-z0-9_.-]{1,20}')
        && request.resource.data.dutyDay is int
        && request.resource.data.dutyDay >= 0
        && request.resource.data.dutyDay <= 5
        && request.resource.data.head is bool;
      allow delete: if isAdmin();
    }

    // รหัสผ่านเข้าระบบ: ผู้ดูแลตั้ง/เปลี่ยนได้ที่หน้าบุคลากร
    match /passwords/{id} {
      allow read, write: if isAdmin();
    }

    // ตารางเวร: ทุกคนในระบบดูได้ ผู้ดูแลจัดการ
    match /schedules/{date} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
  }
}
