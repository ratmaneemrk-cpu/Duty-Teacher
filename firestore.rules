rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }
    function isStaff() {
      return signedIn() && myRole() in ['teacher', 'admin'];
    }
    function reportDoc(id) {
      return get(/databases/$(database)/documents/reports/$(id)).data;
    }

    // ผู้ใช้: สมัครใหม่ได้สถานะ pending เท่านั้น ผู้ดูแลเป็นคนกำหนดบทบาท
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'pending';
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // รายงานเวร: ครูเห็น/แก้ได้เฉพาะของตนเองที่ยังไม่ถูกรับทราบ ผู้ดูแลเห็นทั้งหมด
    match /reports/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.uid == request.auth.uid);
      allow create: if isStaff()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && !request.resource.data.keys().hasAny(['adminComment', 'acknowledgedBy', 'acknowledgedAt']);
      allow update: if isAdmin()
        || (isStaff()
            && resource.data.uid == request.auth.uid
            && resource.data.status == 'submitted'
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['uid', 'status', 'adminComment', 'acknowledgedBy', 'acknowledgedAt']));
      allow delete: if isAdmin()
        || (isStaff() && resource.data.uid == request.auth.uid && resource.data.status == 'submitted');

      match /photos/{photoId} {
        allow read: if isAdmin() || (isStaff() && reportDoc(id).uid == request.auth.uid);
        allow write: if isAdmin()
          || (isStaff() && reportDoc(id).uid == request.auth.uid && reportDoc(id).status == 'submitted');
      }
    }

    // ตารางเวร: ทุกคนในระบบดูได้ ผู้ดูแลจัดการ
    match /schedules/{date} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
  }
}
